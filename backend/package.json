{
  "name": "backend",
  "version": "2.5.2",
  "description": "Whisprl Backend",
  "main": "server.js",
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "Whisprl",
    "Chat",
    "ChatApp",
    "MERN",
    "NodeJS",
    "Express",
    "MongoDB",
    "MERNChat"
  ],
  "author": "Vaibhaw Mishra",
  "license": "CC0-1.0",
  "dependencies": {
    "@sentry/node": "^11.9.0",
    "@simplewebauthn/server": "^14.0.3",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "image-size": "^2.0.4",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "socket.io": "^4.8.4",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
