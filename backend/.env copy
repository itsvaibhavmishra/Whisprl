# Required
PORT = 8000
MONGODB_URI = ""
JWT_ACCESS_SECRET = ""

# The one account that owns Whisprl, by email
OWNER_EMAIL = ""

# Origin - (Required-Change with your frontend url)
FRONT_URL = "http://localhost:3000"
# The origins the Android app is served from, allowed beside FRONT_URL, comma separated
# (can be skipped without the app)
APP_ORIGIN = "https://localhost"

# Nodemailer Config (Can be skipped | required for the account deletion code and new device emails)
MAIL_USER = ''
MAIL_PASS = ''

# Cloudinary Config (Can be skipped but required for image uploads)
CLOUDINARY_CLOUD_NAME = ""
CLOUDINARY_API_KEY = ""
CLOUDINARY_API_SECRET = ""

# Google sign in, the only way in (the same client id as the frontend's REACT_APP_GOOGLE_AUTH_CLIENT_ID)
GOOGLE_AUTH_CLIENT_ID = ""

# The one account Play's reviewers sign in to with a password (can be skipped, nobody can then)
REVIEW_ACCOUNT_EMAIL = ""
REVIEW_ACCOUNT_PASSWORD = ""

# Push notifications for the Android app (can be skipped, the server then sends none)
# The Firebase service account's JSON, on one line
FIREBASE_SERVICE_ACCOUNT = ''

# Sentry error reports, for the production server only: leave it out in development
SENTRY_DSN = ''
